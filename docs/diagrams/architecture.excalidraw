   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Raft RPCs flow between replicas of the same group (e.g. G1 on n1, n2, n3).\nController replicas co-locate on n1-n3 in production. 1024 shards; shard = hash(key) mod 1024.",
   "originalText": "Raft RPCs flow between replicas of the same group (e.g. G1 on n1, n2, n3).\nController replicas co-locate on n1-n3 in production. 1024 shards; shard = hash(key) mod 1024.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
